# syntax=docker/dockerfile:1

FROM golang:1.25-alpine AS singbox-builder
ARG SINGBOX_VERSION=v1.13.14
RUN apk add --no-cache git
RUN git clone --depth 1 --branch ${SINGBOX_VERSION} https://github.com/SagerNet/sing-box.git /src/sing-box
WORKDIR /src/sing-box
RUN CGO_ENABLED=0 go build -v -trimpath \
    -tags "with_gvisor,with_quic,with_dhcp,with_wireguard,with_utls,with_acme,with_clash_api,with_v2ray_api,with_tailscale" \
    -o /usr/local/bin/sing-box ./cmd/sing-box

FROM rust:1.86-alpine AS rust-builder
RUN apk add --no-cache musl-dev pkgconfig ca-certificates
WORKDIR /app
COPY Cargo.toml Cargo.lock sqlx.toml ./
COPY crates/ ./crates/
RUN cargo build --release --locked -p aethergate-agent && \
    strip target/release/aethergate-agent

FROM scratch
COPY --from=rust-builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=singbox-builder /usr/local/bin/sing-box /usr/local/bin/sing-box
COPY --from=rust-builder /app/target/release/aethergate-agent /aethergate-agent
ENTRYPOINT ["/aethergate-agent"]
CMD ["--config", "/etc/aethergate/config.agent.toml"]
