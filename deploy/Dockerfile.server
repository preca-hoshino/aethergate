# syntax=docker/dockerfile:1

FROM node:22-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM rust:1.86-alpine AS rust-builder
ARG TARGETARCH
RUN apk add --no-cache musl-dev pkgconfig openssl-dev openssl-libs-static ca-certificates
WORKDIR /app
COPY Cargo.toml Cargo.lock sqlx.toml ./
COPY crates/ ./crates/
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist
RUN cargo build --release --locked -p aethergate-server && \
    strip target/release/aethergate-server

FROM scratch
COPY --from=rust-builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=rust-builder /app/target/release/aethergate-server /aethergate-server
EXPOSE 8080
ENTRYPOINT ["/aethergate-server"]
CMD ["--config", "/etc/aethergate/config.server.toml"]
