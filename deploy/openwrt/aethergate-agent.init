#!/bin/sh /etc/rc.common
# Æthergate Node Agent OpenWrt procd init script (/etc/init.d/aethergate-agent)
# Keep binary & WAL off flash if needed, or configure wal_dir on external storage.

START=98
STOP=10
USE_PROCD=1

PROG="/usr/bin/aethergate-agent"
CONF="/etc/aethergate/agent.toml"

start_service() {
	[ -x "$PROG" ] || return 1
	[ -f "$CONF" ] || return 1

	procd_open_instance
	procd_set_param command "$PROG" --config "$CONF"
	procd_set_param env RUST_LOG="aethergate_agent=info"
	procd_set_param respawn 3600 5 0
	procd_set_param limits core="0 0"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
