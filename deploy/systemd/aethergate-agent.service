[Unit]
Description=Æthergate Node Daemon (sing-box supervisor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/aethergate-agent --config /etc/aethergate/config.agent.toml
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
